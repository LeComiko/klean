# Variables non secrètes qu'une version ajoute à .env, avec leur défaut. `klean`
# complète .env à l'installation et à chaque mise à jour, sans jamais écraser une
# ligne existante. Une valeur @SECRET@ est tirée au hasard, une fois.
KLEAN_GEOCODAGE=false
# Le fuseau de la sauvegarde de la nuit, faite à 3 h de cette heure-là : un nom de
# /usr/share/zoneinfo — Europe/Paris, America/Martinique, Indian/Reunion…
KLEAN_FUSEAU=Europe/Paris
# L'IPv6 du réseau `public` de Caddy, qui reçoit les visiteurs sous leur vraie adresse.
# false sur une machine sans IPv6, où ce réseau ne se créerait peut-être pas. Une
# installation neuve l'écrit d'après la machine ; une mise à jour ajoute ce défaut.
KLEAN_IPV6=true
