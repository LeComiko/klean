#!/usr/bin/env bash
# La commande d'exploitation de KLEAN (SPEC.md, étape 34, lot A1), installée dans
# /opt/klean et appelée par /usr/local/bin/klean.
#
#   sudo klean installer               première installation, ou reprise
#   sudo klean mettre-a-jour [1.2.3]   sans version : la dernière publiée
#   sudo klean revenir                 la version précédente, et la base d'avant (14 jours)
#   sudo klean sauvegarder             une sauvegarde, tout de suite
#   sudo klean restaurer <sauvegarde>
#   sudo klean etat | journaux | code
#
# ⚠️ Tout le corps est dans des fonctions, et `principal` n'est appelée qu'à la
# dernière ligne. `mettre-a-jour` remplace ce fichier pendant qu'il tourne, et bash
# lit un script au fil de l'exécution : le remplacement se fait par `mv`, qui laisse
# l'ancien fichier au processus en cours, et une fonction déjà lue ne se relit pas.
# shellcheck disable=SC2329  # outils définis avant leurs appelants
set -euo pipefail
umask 077

REPERTOIRE="${KLEAN_REPERTOIRE:-/opt/klean}"
ENV="$REPERTOIRE/.env"
# Deux racines, et non deux dossiers frères : une copie « du dossier des sauvegardes »
# ne doit jamais emporter la base et le trousseau ensemble (CLAUDE.md §6).
SAUVEGARDES="${KLEAN_SAUVEGARDES:-/var/backups/klean}"
VERROU="${KLEAN_VERROU:-/run/klean.lock}"
TROUSSEAU="${KLEAN_TROUSSEAU:-/var/lib/klean-trousseau}"
JOURNAL_NUIT=/var/log/klean-sauvegarde.log
JOURS_CONSERVATION=14

# shellcheck source-path=SCRIPTDIR source=fonctions.sh
. "$REPERTOIRE/fonctions.sh"

# ---- Outils ----------------------------------------------------------------------

dire() { printf '%s\n' "$*"; }
avertir() { printf '⚠️  %s\n' "$*" >&2; }
echouer() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

compose() {
  docker compose --project-directory "$REPERTOIRE" --env-file "$ENV" \
    -f "$REPERTOIRE/docker-compose.yml" "$@"
}

exiger_root() {
  [ "$(id -u)" -eq 0 ] || echouer "Cette commande se lance en root : sudo klean ${COMMANDE:-}"
}

# Les questions se lisent sur le terminal, jamais sur l'entrée standard : lancé par
# `curl … | sudo bash`, l'entrée standard est le script lui-même.
#
# demander « question » [défaut] : la réponse dans REPONSE. Une variable et non la
# sortie : appelée dans $(…), l'arrêt ci-dessous ne quitterait que le sous-shell.
# Ctrl-D ou un terminal fermé arrêtent tout — une question reposée à un terminal muet
# tournerait sans fin.
REPONSE=''
demander() {
  printf '%s%s : ' "$1" "${2:+ [$2]}" > /dev/tty
  if ! IFS= read -r REPONSE < /dev/tty; then
    printf '\n' > /dev/tty
    echouer "Saisie interrompue. Relancez : sudo klean ${COMMANDE:-}"
  fi
  REPONSE="${REPONSE:-${2:-}}"
}

demander_secret() {
  printf '%s : ' "$1" > /dev/tty
  if ! IFS= read -rs REPONSE < /dev/tty; then
    printf '\n' > /dev/tty
    echouer "Saisie interrompue. Relancez : sudo klean ${COMMANDE:-}"
  fi
  printf '\n' > /dev/tty
}

# demander_valide validation « question » [défaut] : repose la question, en disant
# pourquoi, tant que la fonction de validation de fonctions.sh refuse la réponse. La
# valeur retenue, normalisée, dans REPONSE.
demander_valide() {
  local validation="$1" valeur
  shift
  while :; do
    demander "$@"
    if valeur=$("$validation" "$REPONSE"); then
      REPONSE="$valeur"
      return
    fi
    printf '  %s\n' "$valeur" > /dev/tty
  done
}

# Réussit sur oui, o, yes ou y, en majuscules ou non.
demander_oui_non() {
  demander_valide reponse_oui_non "$1 (oui/non)" "$2"
  [ "$REPONSE" = oui ]
}

# confirmer « question » MOT : réussit si l'utilisateur tape MOT, exactement.
confirmer() {
  local reponse
  printf '%s\nTapez %s pour continuer : ' "$1" "$2" > /dev/tty
  read -r reponse < /dev/tty
  [ "$reponse" = "$2" ]
}

attendre_postgres() {
  for _ in $(seq 1 30); do
    if compose exec -T postgres pg_isready -U klean -d klean > /dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  echouer "PostgreSQL ne répond pas après une minute. Voir : sudo klean journaux"
}

nombre_de_comptes() {
  compose exec -T postgres psql -U klean -d klean -tAc 'SELECT count(*) FROM "AspNetUsers"'
}

# En propriétaire des tables, donc hors de la RLS : toutes les entreprises se comptent.
nombre_d_entreprises() {
  compose exec -T postgres psql -U klean -d klean -tAc 'SELECT count(*) FROM "Entreprises"'
}

# verrouiller [attente_en_secondes] : une seule commande klean qui touche à la base ou
# aux sauvegardes à la fois. La tâche de nuit et un `sudo klean sauvegarder` lancé à la
# main, ou une mise à jour, s'écraseraient sinon : deux `pg_dump`, ou pire une
# restauration pendant une sauvegarde.
#
# ⚠️ `restaurer`, `installer`, `mettre-a-jour` et `revenir` l'appellent au début, sans
# attente : une commande lancée à la main échoue tout de suite et dit pourquoi.
# Réentrant dans le même processus : `mettre-a-jour` appelle `cmd_sauvegarder`, qui
# redemanderait un verrou que le même processus tient déjà, et s'attendrait lui-même.
# Le descripteur 9 reste ouvert jusqu'à la fin du processus, qui libère le verrou.
verrouiller() {
  local attente="${1:-0}" options=(-n)
  [ "$attente" -eq 0 ] || options=(-w "$attente")
  prendre_verrou "${options[@]}" ||
    echouer "Une autre commande klean est en cours (la sauvegarde de la nuit ?). Réessayez dans quelques minutes."
}

# prendre_verrou options-de-flock… : le geste de verrouiller, sans rien dire. Réussit si
# le verrou est pris, ou déjà tenu ; échoue sinon. retirer_code_si_installe s'en sert sans
# attente : appelée par `etat`, elle passe son tour plutôt que d'écrire .env sous une mise
# à jour qui l'écrit aussi.
prendre_verrou() {
  [ -z "${KLEAN_VERROUILLE:-}" ] || return 0
  # Hérité d'un `exec klean …` qui le tenait déjà : le reprendre sans rouvrir le fichier.
  # Rouvrir fermerait le descripteur, donc le verrou, et la sauvegarde de la nuit en
  # attente pourrait s'en emparer entre les deux.
  if [ "$(readlink "/proc/$$/fd/9" 2> /dev/null)" != "$VERROU" ]; then
    exec 9> "$VERROU"
  fi
  flock "$@" 9 || return 1
  KLEAN_VERROUILLE=1
}

# ---- Sauvegarder -------------------------------------------------------------------

# Chemin de la dernière sauvegarde de la base écrite par cmd_sauvegarder. Lue par
# mettre-a-jour, qui appelle cmd_sauvegarder dans le même processus.
DERNIERE_SAUVEGARDE=''

cmd_sauvegarder() {
  exiger_root
  # La tâche de nuit attend jusqu'à une demi-heure plutôt que d'abandonner : une
  # commande à la main, ou une mise à jour, qui tient le verrou à 3 h 30 n'a pas à
  # coûter la sauvegarde de la nuit.
  verrouiller 1800
  local suffixe="${1:-}" horodatage nom temporaire
  # À la seconde, et jamais par-dessus une autre : deux sauvegardes de la même minute —
  # une mise à jour, un retour raté, une seconde mise à jour — remplaçaient sinon la
  # première, qui pouvait être la seule copie d'avant la mise à jour. …THHMMSS suit le
  # motif de la rotation (sauvegardes_a_supprimer).
  horodatage=$(date +%Y-%m-%dT%H%M%S)
  install -d -m 700 "$SAUVEGARDES" "$TROUSSEAU"
  nom="$SAUVEGARDES/klean-$horodatage${suffixe:+-$suffixe}.dump"
  [ ! -e "$nom" ] || nom="${nom%.dump}-$$.dump"
  # Un nom imprévisible, et qui ne suit pas le motif des sauvegardes : ni la rotation ni
  # la restauration ne peuvent le prendre pour une copie.
  temporaire=$(mktemp "$SAUVEGARDES/.partiel.XXXXXX")

  # Écrite à côté, relue, puis renommée : un pg_dump interrompu laisserait sinon un
  # fichier vide, et la rotation supprimerait les bonnes copies à sa place.
  if ! compose exec -T postgres pg_dump -U klean -d klean -Fc > "$temporaire"; then
    rm -f "$temporaire"
    echouer "La sauvegarde de la base a échoué. Les sauvegardes précédentes sont intactes."
  fi
  # `--list` ne lit que la table des matières : il réussirait sur un fichier tronqué.
  # Une restauration vers /dev/null relit tout, données comprises.
  if ! compose exec -T postgres pg_restore -f /dev/null < "$temporaire"; then
    rm -f "$temporaire"
    echouer "La sauvegarde de la base est illisible : elle n'est pas gardée."
  fi
  chmod 600 "$temporaire"
  mv -f "$temporaire" "$nom"
  DERNIERE_SAUVEGARDE="$nom"

  sauvegarder_trousseau "$horodatage"
  tourner "$SAUVEGARDES" 'klean-*.dump'
  tourner "$TROUSSEAU" 'trousseau-*.tgz'
  date +%s > "$SAUVEGARDES/.derniere-reussie"
  dire "Sauvegarde : $nom"
}

# La tâche de nuit, que klean.cron appelle à chaque heure. Le cron de Debian suit le
# fuseau du système — UTC sur un VPS, 4 h 30 à Paris l'hiver pour un « 3 h 30 » — et ignore
# CRON_TZ : seule l'heure de 3 h dans le fuseau de .env sauvegarde, une fois par nuit,
# changement d'heure compris. Le journal ne s'ouvre qu'alors : une heure sans
# sauvegarde effacerait sinon celui de la nuit. Un fuseau inconnu ne coûte pas la
# sauvegarde : elle se fait à 3 h UTC, et le journal le dit.
cmd_sauvegarde_de_nuit() {
  exiger_root
  local fuseau
  fuseau=$(lire_env "$ENV" KLEAN_FUSEAU)
  fuseau="${fuseau:-Europe/Paris}"
  if fuseau_valide "$fuseau"; then
    heure_de_la_sauvegarde "$fuseau" || return 0
    exec > "$JOURNAL_NUIT" 2>&1
  else
    heure_de_la_sauvegarde UTC || return 0
    exec > "$JOURNAL_NUIT" 2>&1
    avertir "KLEAN_FUSEAU vaut « $fuseau », qui n'est pas un fuseau connu (exemple : Europe/Paris, Indian/Reunion) : sauvegarde à 3 h UTC. Corrigez-le dans $ENV."
  fi
  cmd_sauvegarder
  # Après la sauvegarde, qu'un échec ici ne doit pas coûter. Le filet d'une mise à jour
  # depuis 0.1.x, conduite par l'ancien `klean`, qui laisse le code dans .env : recréer
  # l'API à 3 h, une fois, est le prix assumé.
  retirer_code_si_installe
}

# Le trousseau ne change presque jamais : une archive n'est gardée que s'il a changé.
# La plus récente contient toutes les clés, anciennes comprises (DEPLOIEMENT.md §4).
sauvegarder_trousseau() {
  local horodatage="$1" temporaire empreinte precedente
  temporaire=$(mktemp "$TROUSSEAU/.partiel.XXXXXX")
  if ! compose exec -T api tar czf - -C /home/app/.aspnet DataProtection-Keys > "$temporaire"; then
    rm -f "$temporaire"
    echouer "La sauvegarde du trousseau a échoué : l'API tourne-t-elle ? Voir : sudo klean etat. La sauvegarde de la base, elle, est gardée : $DERNIERE_SAUVEGARDE"
  fi
  # Une instance où personne ne s'est encore connecté n'a aucune clé : ce n'est pas une
  # panne, et la sauvegarde de la base ne doit pas échouer pour autant.
  if ! tar tzf "$temporaire" | grep 'key-.*\.xml$' > /dev/null; then
    rm -f "$temporaire"
    avertir "Le trousseau ne contient encore aucune clé : rien à sauvegarder de ce côté."
    return
  fi
  empreinte=$(tar xzf "$temporaire" -O | sha256sum | cut -d' ' -f1)
  precedente=$(cat "$TROUSSEAU/.empreinte" 2> /dev/null || true)
  # Une empreinte sans archive — les trousseau-*.tgz ont été déplacés ou supprimés — ne
  # prouve rien : sans archive, le trousseau n'est pas sauvegardé, même inchangé.
  if [ -z "$(find "$TROUSSEAU" -maxdepth 1 -type f -name 'trousseau-*.tgz' -print -quit)" ]; then
    precedente=''
  fi
  if [ "$empreinte" = "$precedente" ]; then
    rm -f "$temporaire"
    return
  fi
  chmod 600 "$temporaire"
  mv -f "$temporaire" "$TROUSSEAU/trousseau-$horodatage.tgz"
  printf '%s\n' "$empreinte" > "$TROUSSEAU/.empreinte"
}

tourner() {
  local dossier="$1" motif="$2" limite fichier
  limite=$(date -d "-$JOURS_CONSERVATION days" +%F)
  # Un Ctrl-C ou un arrêt brutal laisse un temporaire. Aucun `trap` : un `trap EXIT` posé
  # dans une fonction vaut pour tout le script et écraserait celui de `mettre-a-jour`.
  # Le verrou garantit qu'aucune autre sauvegarde n'écrit en ce moment ; un jour de
  # marge pour ne rien supposer d'autre.
  find "$dossier" -maxdepth 1 -type f -name '.partiel.*' -mmin +1440 -delete
  sauvegardes_a_supprimer "$(find "$dossier" -maxdepth 1 -type f -name "$motif")" "$limite" |
    while IFS= read -r fichier; do
      [ -z "$fichier" ] || rm -f -- "$fichier"
    done
}

# ---- État, journaux, code ----------------------------------------------------------

cmd_etat() {
  exiger_root
  local derniere heures libre enmarche service en_cours
  # Avant le tableau des services, qui montre alors l'API recréée. Jamais le code lui-même.
  retirer_code_si_installe
  dire "KLEAN $(lire_env "$ENV" KLEAN_VERSION) — https://$(lire_env "$ENV" KLEAN_DOMAINE)"
  # -a : un service arrêté ou sorti en erreur n'apparaît sinon pas du tout.
  compose ps -a --format 'table {{.Service}}\t{{.State}}\t{{.Status}}' ||
    avertir "Docker ne répond pas : l'état des services est inconnu."
  if enmarche=$(compose ps --status running --services 2> /dev/null); then
    for service in postgres api caddy; do
      grep -qx "$service" <<< "$enmarche" ||
        avertir "Le service $service ne tourne pas. Voir : sudo klean journaux"
    done
  else
    avertir "Docker ne répond pas : impossible de dire quels services tournent."
  fi
  en_cours=$(lire_env "$ENV" KLEAN_RETOUR_EN_COURS)
  if [ -n "$en_cours" ]; then
    avertir "Un retour à la version $en_cours n'a pas abouti : la base est peut-être vide. Terminez-le : sudo klean revenir"
  else
    en_cours=$(lire_env "$ENV" KLEAN_MAJ_EN_COURS)
    [ -z "$en_cours" ] ||
      avertir "La mise à jour vers $en_cours n'a pas abouti : reprenez-la (sudo klean mettre-a-jour) ou annulez-la (sudo klean revenir)."
  fi

  derniere=$(cat "$SAUVEGARDES/.derniere-reussie" 2> /dev/null || true)
  [[ $derniere =~ ^[0-9]+$ ]] || derniere=0
  heures=$((($(date +%s) - derniere) / 3600))
  if [ "$derniere" -eq 0 ]; then
    avertir "Aucune sauvegarde réussie. Lancez : sudo klean sauvegarder"
  elif [ "$heures" -gt 48 ]; then
    avertir "Dernière sauvegarde réussie il y a $heures heures. Voir $JOURNAL_NUIT, puis : sudo klean sauvegarder"
  else
    dire "Dernière sauvegarde réussie il y a $heures heure(s)."
  fi

  libre=$(df -Pk "$SAUVEGARDES" 2> /dev/null | awk 'NR == 2 { print $4 }')
  if [[ $libre =~ ^[0-9]+$ ]] && [ "$libre" -lt 1048576 ]; then
    avertir "Moins d'un gigaoctet libre sur le disque des sauvegardes."
  fi
  avertir "Aucune copie hors de ce serveur : s'il est perdu, les sauvegardes le sont avec lui. Copiez $SAUVEGARDES et $TROUSSEAU ailleurs, séparément (README, section Sauvegardes)."
}

cmd_journaux() {
  exiger_root
  compose logs --tail "${1:-200}" api caddy
}

# Le code de l'assistant d'installation (lot A2), tant qu'aucun compte n'existe. Il en
# tire un s'il manque — l'API refuse de démarrer sur une base vide sans lui ni variables
# d'amorçage, et son message renvoie ici. Montré seulement si KLEAN répond en HTTPS :
# l'assistant ne s'ouvre pas avant.
cmd_code() {
  exiger_root
  # Sans attente : le code s'écrit peut-être dans .env, qu'une mise à jour écrit aussi.
  verrouiller
  local comptes etat
  retirer_code_si_installe
  # Une sortie vide n'est pas « zéro compte » : PostgreSQL muet ne prouve pas que KLEAN
  # n'est pas installé, ni qu'il l'est.
  comptes=$(nombre_de_comptes) || comptes=''
  etat=$(etat_installation "$comptes") ||
    echouer "PostgreSQL ne répond pas : impossible de savoir si KLEAN est installé. Voir : sudo klean etat"
  if [ "$etat" = installee ]; then
    dire "KLEAN est déjà installé : le code d'installation ne sert plus."
    return
  fi
  CODE_TIRE=''
  assurer_code_installation api "Relancez : sudo klean code"
  if [ -n "$CODE_TIRE" ]; then
    # L'API vient d'être recréée, peut-être après des heures de refus : un seul essai
    # tomberait sur son démarrage. L'attente de l'installation, et ses diagnostics.
    verifier_https || echouer "KLEAN ne répond pas encore en HTTPS : voir sudo klean etat"
  else
    [ "$(sonde_https)" = 200 ] || echouer "KLEAN ne répond pas encore en HTTPS : voir sudo klean etat"
  fi
  montrer_code_installation
}

# Rempli par assurer_code_installation : CODE_TIRE si elle vient d'en tirer un,
# ASSISTANT_OUVERT si la base n'a aucun compte.
CODE_TIRE=''
ASSISTANT_OUVERT=''

# Aucun compte, et aucun code dans .env : en tirer un (generer_code), sinon l'API refuserait
# de démarrer (AmorcageService). Une sauvegarde prise avant le premier compte, restaurée
# après, ne rouvre ainsi pas l'assistant avec l'ancien code, déjà retiré.
#   $1 = api : recréer l'API, qui ne lit son environnement qu'à sa création. Vide :
#        l'appelant la démarre juste après.
#   $2 : la phrase qui dit comment reprendre, si PostgreSQL ne répond pas.
assurer_code_installation() {
  local comptes etat code
  comptes=$(nombre_de_comptes) || comptes=''
  etat=$(etat_installation "$comptes") ||
    echouer "PostgreSQL ne répond pas : impossible de savoir si un compte existe. Voir : sudo klean etat. $2"
  [ "$etat" = a-faire ] || return 0
  ASSISTANT_OUVERT=1
  [ -z "$(lire_env "$ENV" KLEAN_CODE_INSTALLATION)" ] || return 0
  code=$(generer_code) ||
    echouer "Le code d'installation n'a pas pu être tiré : rien n'a changé. $2"
  ecrire_env KLEAN_CODE_INSTALLATION "$code"
  CODE_TIRE=1
  [ "${1:-}" = api ] || return 0
  compose up -d api ||
    echouer "Le code d'installation est écrit dans la configuration, mais l'API n'a pas redémarré. Voir : sudo klean journaux. $2"
}

# Dès qu'un compte existe, le code ne sert plus, ni les restes de l'amorçage d'une version
# 0.1.x (cles_d_installation_a_retirer) : vidés de .env, puis l'API recréée, dont le
# conteneur gardait le code dans son environnement. Silencieuse s'il n'y a rien à retirer,
# si PostgreSQL ne répond pas — elle ne sait alors pas, et la prochaine fois saura —, ou si
# une autre commande klean tient le verrou : celle-là écrit peut-être .env.
retirer_code_si_installe() {
  local comptes cles cle paires=()
  comptes=$(nombre_de_comptes 2> /dev/null) || comptes=''
  cles=$(cles_d_installation_a_retirer "$ENV" "$comptes") || return 0
  [ -n "$cles" ] || return 0
  prendre_verrou -n || return 0
  while IFS= read -r cle; do
    paires+=("$cle" '')
  done <<< "$cles"
  ecrire_env "${paires[@]}"
  dire "KLEAN a ses comptes : ce qui ne servait qu'à l'installation est retiré de la configuration (${cles//$'\n'/, })."
  compose up -d api ||
    avertir "L'API n'a pas redémarré après le retrait du code d'installation. Voir : sudo klean journaux"
}

# Le geste qu'attend le patron, donc toujours le dernier de l'installation, et jamais
# avant le certificat : l'assistant ne s'ouvre pas sans HTTPS. Rien si un compte existe.
# ⚠️ Le code ne passe jamais dans une adresse : un lien pré-rempli finirait dans
# l'historique du navigateur et dans les journaux.
montrer_code_installation() {
  local comptes entreprises etat code
  comptes=$(nombre_de_comptes) || comptes=''
  entreprises=$(nombre_d_entreprises) || entreprises=''
  etat=$(etat_installation "$comptes" "$entreprises") ||
    echouer "PostgreSQL ne répond pas : impossible de savoir si KLEAN est installé. Le code reste lisible par : sudo klean code"
  case "$etat" in
    installee) return 0 ;;
    # L'assistant ne la reprend pas : montrer le code n'ouvrirait qu'un refus.
    orpheline)
      avertir "Une entreprise existe sans aucun compte : DEPLOIEMENT.md, « Une entreprise sans compte »."
      return 0
      ;;
  esac
  code=$(lire_env "$ENV" KLEAN_CODE_INSTALLATION)
  [ -n "$code" ] || echouer "Aucun code d'installation dans $ENV. Pour en tirer un : sudo klean code"
  dire ''
  dire "KLEAN est installé : ouvrez https://$(lire_env "$ENV" KLEAN_DOMAINE) — un assistant crée votre entreprise et votre compte."
  dire "Il demande ce code : $(code_lisible "$code")"
  dire "Il reste lisible par : sudo klean code — jusqu'à la création du premier compte."
}

# ---- Restaurer -------------------------------------------------------------------

# Les sauvegardes de la base que `restaurer` accepte, une par ligne.
lister_sauvegardes() {
  local liste
  liste=$(find "$SAUVEGARDES" -maxdepth 1 -type f -name 'klean-*.dump' 2> /dev/null | sort)
  if [ -n "$liste" ]; then
    dire "Sauvegardes disponibles :"
    printf '  %s\n' "$liste"
  else
    dire "Aucune sauvegarde dans $SAUVEGARDES."
  fi
}

# L'archive de trousseau la plus récente, ou rien : elle contient toutes les clés,
# anciennes comprises (DEPLOIEMENT.md §4).
derniere_archive_trousseau() {
  find "$TROUSSEAU" -maxdepth 1 -type f -name 'trousseau-*.tgz' 2> /dev/null | sort | tail -n 1
}

cmd_restaurer() {
  exiger_root
  # Sans attente : une restauration lancée pendant une sauvegarde ou une mise à jour
  # échoue tout de suite et dit pourquoi.
  verrouiller
  local sauvegarde="${1:-}"
  if [ -z "$sauvegarde" ]; then
    lister_sauvegardes
    echouer "Indiquez une sauvegarde : sudo klean restaurer $SAUVEGARDES/klean-AAAA-MM-JJTHHMMSS.dump"
  fi
  if [ ! -f "$sauvegarde" ]; then
    lister_sauvegardes >&2
    echouer "Fichier introuvable : $sauvegarde."
  fi
  compose up -d postgres
  attendre_postgres
  # Relue en entier, données comprises (`--list` réussirait sur un fichier tronqué) :
  # c'est avant de détruire la base qu'il faut savoir que la sauvegarde est lisible.
  compose exec -T postgres pg_restore -f /dev/null < "$sauvegarde" ||
    echouer "Cette sauvegarde est illisible. Rien n'a changé."

  avertir "Tout ce qui a été saisi après cette sauvegarde sera perdu."
  avertir "Les comptes fermés et les mots de passe changés depuis reviennent à leur état d'alors, les pseudonymisations et les purges sont défaites (rejouez-les : DEPLOIEMENT.md §7)."
  avertir "Toutes les sessions sont fermées : chacun devra se reconnecter."
  # C'est maintenant qu'il faut le dire : après la destruction, il est trop tard pour
  # aller chercher la copie du trousseau.
  if [ -z "$(derniere_archive_trousseau)" ]; then
    avertir "Aucune archive de trousseau dans $TROUSSEAU : si les clés de cette machine ne sont pas celles de la sauvegarde, chaque compte devra rééquiper son second facteur (DEPLOIEMENT.md §10). Si vous l'avez ailleurs, copiez l'archive avant de continuer."
  fi
  avertir "L'état actuel sera d'abord copié dans $SAUVEGARDES (…-avant-restauration.dump, gardé 14 jours)."
  confirmer "Restaurer ${sauvegarde##*/} ?" RESTAURER || echouer "Restauration abandonnée. Rien n'a changé."

  restaurer_base "$sauvegarde" migrer
  dire "Restauration terminée. Vérifiez que l'API répond : sudo klean etat"
}

# Repart d'une base vide, puis restaure : `pg_restore --clean` laisserait en place les
# tables qu'une version plus récente a ajoutées, et la mise à jour suivante échouerait
# en les recréant (plan de l'étape 34, décision 2).
#
# $2 = migrer : rejoue les migrations de la version installée avant de démarrer —
# une sauvegarde plus ancienne que les images laisserait sinon le schéma en retard.
# `revenir` ne le demande pas : il remet aussi les images d'avant.
#
# $3 : la commande qui reprend, si ce n'est pas `restaurer` — `revenir` la donne. Ses
# échecs ne proposent alors pas « sudo klean restaurer <copie> » pour annuler : la copie
# est celle de la version d'après, que les fichiers remis en place ne savent plus lire.
restaurer_base() {
  local sauvegarde="$1" migrations="${2:-}" relance="${3:-sudo klean restaurer $1}"
  local copie='' temporaire sortie annuler presente
  compose up -d postgres
  attendre_postgres
  compose stop api
  # Un échec entre DROP et CREATE laisse la grappe sans base `klean` : pg_dump échouerait
  # alors à chaque relance, et la restauration ne reprendrait jamais.
  presente=$(compose exec -T postgres psql -U klean -d postgres -tAc \
    "SELECT count(*) FROM pg_database WHERE datname = 'klean'") || presente=''
  [[ $presente =~ ^[01]$ ]] ||
    echouer "PostgreSQL ne répond pas : rien n'a été détruit. L'API est arrêtée : sudo klean etat, puis relancez : $relance"

  # La copie de l'état courant, avant de le détruire : une restauration lancée sur la
  # mauvaise sauvegarde, ou qui échoue, ne doit pas coûter les saisies d'aujourd'hui.
  # Elle n'appelle pas cmd_sauvegarder : le trousseau s'y lit dans l'API, arrêtée ici.
  # Même forme que ses fichiers, donc la rotation la garde quatorze jours.
  install -d -m 700 "$SAUVEGARDES"
  if [ "$presente" = 0 ]; then
    avertir "La base de KLEAN n'existe plus (une restauration précédente s'est arrêtée en chemin) : il n'y a pas d'état actuel à copier, la restauration reprend directement."
  else
    # À la seconde, et jamais par-dessus une autre : un `revenir` ou un `restaurer`
    # relancé dans la même minute, après un échec qui a laissé la base vide, remplaçait
    # sinon la copie des vraies données par celle de la base vide.
    copie="$SAUVEGARDES/klean-$(date +%Y-%m-%dT%H%M%S)-avant-restauration.dump"
    [ ! -e "$copie" ] || copie="${copie%.dump}-$$.dump"
    temporaire=$(mktemp "$SAUVEGARDES/.partiel.XXXXXX")
    if ! compose exec -T postgres pg_dump -U klean -d klean -Fc > "$temporaire" ||
      ! compose exec -T postgres pg_restore -f /dev/null < "$temporaire"; then
      rm -f "$temporaire"
      echouer "La copie de l'état actuel a échoué, donc rien n'a été détruit. L'API est arrêtée : sudo klean etat, puis relancez : $relance"
    fi
    chmod 600 "$temporaire"
    mv -f "$temporaire" "$copie"
    dire "État actuel copié : $copie"
  fi

  if [ -z "$copie" ]; then
    sortie="Relancez : $relance"
    annuler="Puis relancez : $relance"
  elif [ -z "${3:-}" ]; then
    sortie="Relancez : $relance, ou revenez à l'état d'avant avec : sudo klean restaurer $copie"
    annuler="Pour annuler : sudo klean restaurer $copie"
  else
    sortie="Relancez : $relance — l'état d'avant reste copié dans $copie."
    annuler="Puis relancez : $relance"
  fi
  compose exec -T postgres psql -U klean -d postgres -v ON_ERROR_STOP=1 \
    -c 'DROP DATABASE IF EXISTS klean WITH (FORCE)' \
    -c 'CREATE DATABASE klean OWNER klean' ||
    echouer "La base n'a pas pu être recréée ; elle est peut-être absente. L'API est arrêtée. $sortie"
  # Le rôle vit dans la grappe, pas dans la base : sur une machine neuve, il manque, et
  # pg_restore s'arrêterait sur les droits qui le nomment (CLAUDE.md §10).
  compose exec -T postgres psql -U klean -d klean -v ON_ERROR_STOP=1 -c \
    "DO \$\$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'klean_app') THEN CREATE ROLE klean_app NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT; GRANT klean_app TO CURRENT_USER; END IF; END \$\$;" ||
    echouer "Le rôle klean_app n'a pas pu être créé : la base est vide et l'API arrêtée. $sortie"
  # Une seule transaction : un échec laisse une base vide, jamais à moitié remplie.
  compose exec -T postgres pg_restore -U klean -d klean --no-owner --exit-on-error --single-transaction < "$sauvegarde" ||
    echouer "La restauration a échoué : la base est vide et l'API arrêtée. $sortie"
  # Les sessions de la sauvegarde valent encore : sans la révocation, un jeton de
  # rafraîchissement d'alors rouvrirait la session d'un compte que la sauvegarde
  # croyait ouvert. Et la révocation seule ne suffit pas (CLAUDE.md §10) : la
  # sauvegarde rend à chaque compte l'empreinte de sécurité qu'il avait, souvent la même
  # qu'aujourd'hui, et tout jeton d'accès déjà émis restait valable jusqu'à quinze
  # minutes — mesuré sur le VPS d'essai, connecté après « toutes les sessions sont
  # fermées ». Une empreinte neuve le fait refuser dès la requête suivante.
  compose exec -T postgres psql -U klean -d klean -v ON_ERROR_STOP=1 -c \
    'BEGIN;
     UPDATE "JetonsRafraichissement" SET "DateRevocation" = now() WHERE "DateRevocation" IS NULL;
     UPDATE "AspNetUsers" SET "SecurityStamp" = upper(replace(gen_random_uuid()::text, '"'-'"', '"''"'));
     COMMIT;' ||
    echouer "La base est restaurée, mais les anciennes sessions n'ont pas pu être révoquées ; l'API reste arrêtée. $sortie"
  restaurer_trousseau "$sortie"
  if [ "$migrations" = migrer ]; then
    compose run --rm -T migrer ||
      echouer "La base est restaurée, mais sa mise au niveau de la version installée a échoué ; l'API reste arrêtée. Voir les lignes ci-dessus et : sudo klean journaux. $annuler"
  fi
  # Une sauvegarde prise avant le premier compte : sans code, l'API refuserait de démarrer,
  # et l'ancien code a été retiré de .env depuis. Sans recréer l'API : elle démarre ici.
  ASSISTANT_OUVERT=''
  assurer_code_installation '' "La base est restaurée, mais l'API reste arrêtée. $annuler"
  compose up -d ||
    echouer "La base est restaurée, mais les services n'ont pas démarré. Voir : sudo klean etat, puis sudo klean journaux. $annuler"
  [ -z "$ASSISTANT_OUVERT" ] ||
    dire "Cette sauvegarde n'a aucun compte : l'assistant d'installation est ouvert. Son code : sudo klean code"
}

# **Toujours fusionné**, jamais « seulement si le volume est vide » : l'API crée une clé
# dès son démarrage, sans requête, donc sur une machine neuve — où `installer` l'a déjà
# démarrée — le volume n'est jamais vide, et l'archive de l'ancienne machine ne serait
# jamais extraite : tous les seconds facteurs deviendraient indéchiffrables, sans message.
# Chaque key-*.xml a son identifiant : l'archive s'ajoute à la clé de la nouvelle
# installation, qui reste valable à côté des anciennes.
#
# **Toutes** les archives, de la plus ancienne à la plus récente, pas la dernière par son
# nom : sur un serveur neuf, une sauvegarde qui a tourné avant la restauration — la tâche
# de la nuit, ou celle que `etat` demande — a écrit une archive datée d'aujourd'hui, qui
# ne porte que la clé neuve ; celle de l'ancienne machine, plus ancienne, ne serait
# jamais lue. Fusionner deux fois une même clé ne change rien.
#
# Le conteneur éphémère monte le volume `cles-api` et tourne sous `app`, l'utilisateur de
# l'API (backend/Dockerfile) : les fichiers extraits lui appartiennent. L'API est arrêtée.
# $1 : la phrase qui dit comment reprendre.
restaurer_trousseau() {
  local archive
  if [ -z "$(derniere_archive_trousseau)" ]; then
    avertir "Aucune archive de trousseau : si les clés de cette machine ne sont pas celles de la sauvegarde, chaque compte devra rééquiper son second facteur (DEPLOIEMENT.md §10)."
    return
  fi
  while IFS= read -r archive; do
    compose run --rm --no-deps -T --entrypoint tar api xzf - -C /home/app/.aspnet < "$archive" ||
      echouer "La base est restaurée, mais pas le trousseau ($archive) ; l'API reste arrêtée. $1"
  done < <(find "$TROUSSEAU" -maxdepth 1 -type f -name 'trousseau-*.tgz' | sort)
}

# ---- Installer ------------------------------------------------------------------

cmd_installer() {
  exiger_root
  # Sans attente : une installation lancée pendant la sauvegarde de la nuit échoue tout de suite.
  verrouiller
  # Dès le début : chaque échec qui suit dit « Relancez : sudo klean installer », et la
  # commande doit déjà exister à ce moment-là.
  ln -sf "$REPERTOIRE/klean" /usr/local/bin/klean
  { : > /dev/tty; } 2> /dev/null ||
    echouer "L'installation pose des questions : lancez-la dans un terminal (par ssh, ajoutez -t : ssh -t serveur '…')."
  if [ -f "$ENV" ]; then
    # Une mise à jour ou un retour inachevé ne se termine que par sa propre commande :
    # installer migrerait une base peut-être vide, et y rouvrirait l'assistant d'installation.
    if [ -n "$(lire_env "$ENV" KLEAN_RETOUR_EN_COURS)" ]; then
      echouer "Un retour à la version précédente n'a pas abouti. Terminez-le : sudo klean revenir"
    fi
    if [ -n "$(lire_env "$ENV" KLEAN_MAJ_EN_COURS)" ]; then
      echouer "Une mise à jour n'a pas abouti. Terminez-la : sudo klean mettre-a-jour, ou annulez-la : sudo klean revenir"
    fi
    verifier_machine
    reprendre_env
    # Une seule fois : reprendre_env vient peut-être de demander le domaine, et de le
    # vérifier avant de l'écrire.
    [ "${DOMAINE_VERIFIE:-}" = "$(lire_env "$ENV" KLEAN_DOMAINE)" ] ||
      verifier_dns "$(lire_env "$ENV" KLEAN_DOMAINE)"
  else
    # Avant verifier_machine : les conteneurs d'une installation qui a perdu son .env
    # occupent les ports, et le refus parlerait d'autre chose que de la vraie cause.
    if volume_postgres_existe; then
      refuser_base_orpheline "son fichier de configuration ($ENV) a disparu"
    fi
    verifier_machine
    preparer_env
  fi
  completer_env_version "$REPERTOIRE" ||
    echouer "La configuration n'a pas pu être complétée : elle est restée telle quelle. Relancez : sudo klean installer"

  install -d -m 700 "$SAUVEGARDES" "$TROUSSEAU"
  dire "Téléchargement des images…"
  compose pull ||
    echouer "Le téléchargement des images de KLEAN a échoué : le serveur est-il bien relié à Internet ? Rien n'est perdu. Relancez dans quelques minutes : sudo klean installer"
  compose up -d postgres ||
    echouer "PostgreSQL n'a pas démarré : voir les lignes ci-dessus. Rien n'est perdu. Relancez : sudo klean installer"
  attendre_postgres
  compose run --rm -T migrer ||
    echouer "La préparation de la base a échoué : voir les lignes ci-dessus. Relancez : sudo klean installer"
  # Après les migrations, seul moment où la table des comptes existe à coup sûr ; avant le
  # démarrage, qui lira le code.
  assurer_code_installation '' "Relancez : sudo klean installer"
  compose up -d ||
    echouer "KLEAN n'a pas démarré : voir les lignes ci-dessus et sudo klean journaux. Relancez : sudo klean installer"
  # Nom sans point : cron ignore un fichier de /etc/cron.d qui en porte un. Mode et
  # propriétaire explicites : le umask 077 de ce script donnerait 600, que cron refuse.
  install -m 644 -o root -g root "$REPERTOIRE/klean.cron" /etc/cron.d/klean

  # Le code n'est jamais montré avant le certificat : l'assistant ne s'ouvre qu'en HTTPS.
  verifier_https ||
    echouer "L'installation n'est pas terminée. Corrigez le point ci-dessus, puis relancez : sudo klean installer — la reprise ne perd rien."
  montrer_puis_retirer_mot_de_passe
  # Après le mot de passe provisoire d'une 0.1.x inachevée, montré puis retiré : les restes
  # de son amorçage partent avec lui (cles_d_installation_a_retirer).
  retirer_code_si_installe
  afficher_fin
  montrer_code_installation
}

verifier_machine() {
  local memoire
  # shellcheck source=/dev/null
  systeme_pris_en_charge "$(. /etc/os-release && printf '%s' "$ID")" "$(dpkg --print-architecture)" ||
    echouer "KLEAN s'installe sur Debian ou Ubuntu, en amd64."
  memoire=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
  memoire_suffisante "$memoire" || echouer "Il faut 1 Go de mémoire au moins (trouvé : $((memoire / 1024)) Mo)."
  # À la reprise, nos propres conteneurs occupent les ports et le réseau.
  [ -f "$ENV" ] && return
  if ss -ltunH '( sport = :80 or sport = :443 )' | grep -q .; then
    echouer "Les ports 80 ou 443 sont déjà pris sur ce serveur (ss -ltunp les montre). KLEAN en a besoin pour son certificat."
  fi
  if ip -4 route | grep -q '^172\.28\.0\.'; then
    echouer "Le réseau 172.28.0.0/24 est déjà utilisé sur ce serveur : voir DEPLOIEMENT.md, réseau du compose."
  fi
}

# Le volume de la base, nommé par compose d'après `name: klean`. « Docker ne répond
# pas » n'est pas « aucun volume » : cette réponse-là ferait tirer un mot de passe que
# la base existante refuserait.
volume_postgres_existe() {
  local volumes
  volumes=$(docker volume ls -q) ||
    echouer "Docker ne répond pas : vérifiez qu'il tourne (systemctl status docker), puis relancez : sudo klean ${COMMANDE:-installer}"
  grep -qx klean_postgres <<< "$volumes"
}

# Une base existe, mais pas le mot de passe qui l'ouvre. POSTGRES_PASSWORD n'est lu
# qu'à la création du volume (CLAUDE.md §10) : un nouveau ne vaudrait rien, et chaque
# relance finirait sur la même API refusée. Rien n'est écrit, et le volume n'est jamais
# supprimé — il porte peut-être les seules données du client.
refuser_base_orpheline() {
  avertir "Une base KLEAN existe déjà sur ce serveur, mais $1. Un nouveau mot de passe ne l'ouvrirait pas."
  avertir "Rien n'a été modifié, et la base est intacte."
  echouer "Remettez l'ancien fichier $ENV à sa place (depuis une copie de ce serveur), puis relancez : sudo klean installer. Sans copie, DEPLOIEMENT.md §6, « Le mot de passe de PostgreSQL », explique comment en donner un nouveau à la base."
}

# ecrire_env clé valeur [clé valeur…] : pose tout dans une copie de .env, puis la met
# à sa place d'un seul geste. Interrompue, elle laisse l'ancien .env, ou aucun : jamais
# un .env à moitié écrit, que la reprise prendrait pour complet. Le nom des copies ne
# ressemble à aucun .env qu'un exploitant garderait à côté : leurs restes partent ici.
ecrire_env() {
  local temporaire
  # Et ceux de poser_env, .env.XXXXXX, qu'une interruption aurait laissés.
  find "$REPERTOIRE" -maxdepth 1 -type f \( -name '.env-en-cours.*' -o -name '.env.??????' \) -delete
  temporaire=$(mktemp "$REPERTOIRE/.env-en-cours.XXXXXX")
  if [ -f "$ENV" ] && ! cat "$ENV" > "$temporaire"; then
    rm -f "$temporaire"
    echouer "La configuration n'a pas pu être relue : elle est restée telle quelle. Relancez : sudo klean ${COMMANDE:-installer}"
  fi
  while [ "$#" -ge 2 ]; do
    if ! poser_env "$temporaire" "$1" "$2"; then
      rm -f "$temporaire"
      echouer "La configuration n'a pas pu être écrite : elle est restée telle quelle. Relancez : sudo klean ${COMMANDE:-installer}"
    fi
    shift 2
  done
  chmod 600 "$temporaire"
  mv -f "$temporaire" "$ENV"
}

# Toutes les questions d'abord, SMTP compris ; .env n'est écrit qu'après la dernière
# réponse, d'un seul geste. Chaque réponse est validée, et la question reposée sur
# refus : une réponse qui passe ici ne fait échouer ni poser_env ni le démarrage de
# l'API (plan de l'étape 34, décision 1, et CLAUDE.md §2).
#
# Aucune question sur l'entreprise ni sur l'administrateur (lot A2) : le patron les crée dans
# le navigateur, avec le code d'installation tiré ici, et aucun mot de passe n'est écrit
# dans .env.
preparer_env() {
  local domaine postgres jwt code
  dire "Installation de KLEAN. Quelques questions, puis tout se fait seul."
  dire "Rien n'est enregistré avant la dernière réponse : Ctrl-C à tout moment, et tout reprendra de zéro."
  demander_valide normaliser_domaine "Nom de domaine de KLEAN (ex. klean.mon-entreprise.fr)"
  domaine="$REPONSE"
  # Tout de suite : un domaine mal saisi se corrige en relançant, avant qu'il soit écrit.
  verifier_dns "$domaine"
  # La localisation des sites par l'API Adresse ne se demande pas encore : aucune version
  # ne la lit avant le lot A3, et un « oui » donné aujourd'hui prendrait effet en silence
  # le jour de cette mise à jour. Elle reste à false, et la question viendra avec elle.
  demander_smtp

  postgres=$(generer_secret 32)
  jwt=$(generer_secret 48)
  # Montré à la toute fin, une fois le certificat obtenu (montrer_code_installation), et
  # retiré de ce fichier dès qu'un compte existe (retirer_code_si_installe).
  code=$(generer_code)
  ecrire_env \
    KLEAN_VERSION "$(cat "$REPERTOIRE/VERSION")" \
    KLEAN_IMAGES "$(nom_images)" \
    KLEAN_DOMAINE "$domaine" \
    POSTGRES_PASSWORD "$postgres" \
    KLEAN_JWT_CLE "$jwt" \
    KLEAN_CODE_INSTALLATION "$code" \
    KLEAN_GEOCODAGE false \
    "${SMTP_ENV[@]}"
}

# Les réponses SMTP, en paires clé valeur pour ecrire_env : toutes, ou aucune. Une
# configuration saisie à moitié empêcherait l'API de démarrer (CLAUDE.md §2) — c'est
# pourquoi l'adresse d'expédition, et le mot de passe d'un identifiant, sont exigés.
SMTP_ENV=()

demander_smtp() {
  local hote port expediteur utilisateur mot_de_passe='' valeur
  SMTP_ENV=()
  dire "Un serveur de courriel permet aux utilisateurs de réinitialiser un mot de passe oublié. Facultatif : sans lui, KLEAN fonctionne, et le changement de mot de passe reste possible depuis l'écran Compte."
  demander_valide hote_smtp "Serveur SMTP (laisser vide pour passer)"
  hote="$REPONSE"
  [ -n "$hote" ] || return 0
  demander_valide port_smtp "Port SMTP" 587
  port="$REPONSE"
  demander_valide expediteur_smtp "Adresse d'expédition des courriels"
  expediteur="$REPONSE"
  demander_valide identifiant_smtp "Identifiant SMTP (laisser vide s'il n'y en a pas)"
  utilisateur="$REPONSE"
  if [ -n "$utilisateur" ]; then
    while :; do
      demander_secret "Mot de passe SMTP"
      if valeur=$(mot_de_passe_smtp "$REPONSE"); then
        mot_de_passe="$valeur"
        break
      fi
      printf '  %s\n' "$valeur" > /dev/tty
    done
  fi
  SMTP_ENV=(KLEAN_SMTP_HOTE "$hote" KLEAN_SMTP_PORT "$port" KLEAN_SMTP_EXPEDITEUR "$expediteur")
  if [ -n "$utilisateur" ]; then
    SMTP_ENV+=(KLEAN_SMTP_UTILISATEUR "$utilisateur" KLEAN_SMTP_MOT_DE_PASSE "$mot_de_passe")
  fi
}

# Les paires clé valeur que reprendre_env écrit d'un geste.
A_ECRIRE=()

# Un .env existant est repris. Il peut pourtant être incomplet : une version antérieure
# de ce script l'écrivait ligne à ligne en posant les questions, et s'arrêtait à la
# première réponse refusée. Ce qui manque est complété — demandé ou tiré —, et rien de
# ce qui est enregistré ne change : jamais un POSTGRES_PASSWORD ni une KLEAN_JWT_CLE
# régénérés par-dessus les existants.
#
# Le code d'installation n'est pas de ce qui manque : il ne sert que sans compte, et seul
# le comptage le dit, après les migrations (assurer_code_installation). Exigé ici, il serait
# tiré de nouveau à chaque reprise d'une instance installée, qui l'avait retiré.
reprendre_env() {
  local manquantes cle base=non
  if volume_postgres_existe; then
    base=oui
  fi
  A_ECRIRE=()
  # La base sans son mot de passe se refuse avant toute question : rien ne la sauve ici.
  if [ "$base" = oui ] && [ -z "$(lire_env "$ENV" POSTGRES_PASSWORD)" ]; then
    refuser_base_orpheline "son mot de passe manque dans $ENV"
  fi
  manquantes=$(cles_manquantes "$ENV" KLEAN_DOMAINE POSTGRES_PASSWORD KLEAN_JWT_CLE \
    KLEAN_VERSION KLEAN_IMAGES)
  if [ -z "$manquantes" ]; then
    dire "Installation existante trouvée dans $REPERTOIRE : elle est reprise, aucun secret n'est régénéré."
  else
    avertir "L'installation précédente s'est arrêtée avant d'avoir tout enregistré. Il manque : $(tr '\n' ' ' <<< "$manquantes")"
    dire "Ce qui manque est complété ; rien de ce qui est déjà enregistré ne change."
  fi
  while IFS= read -r cle; do
    case "$cle" in
      '') ;;
      KLEAN_DOMAINE)
        demander_valide normaliser_domaine "Nom de domaine de KLEAN (ex. klean.mon-entreprise.fr)"
        # Vérifié avant d'être écrit : un « non » laisse la question à la prochaine
        # reprise, au lieu d'enregistrer un nom peut-être mal saisi.
        verifier_dns "$REPONSE"
        A_ECRIRE+=("$cle" "$REPONSE")
        ;;
      POSTGRES_PASSWORD)
        if [ "$base" = oui ]; then
          refuser_base_orpheline "son mot de passe manque dans $ENV"
        fi
        A_ECRIRE+=("$cle" "$(generer_secret 32)")
        ;;
      # Sans risque même avec des comptes : les sessions survivent à une nouvelle clé
      # (DEPLOIEMENT.md §6).
      KLEAN_JWT_CLE) A_ECRIRE+=("$cle" "$(generer_secret 48)") ;;
      KLEAN_VERSION) A_ECRIRE+=("$cle" "$(cat "$REPERTOIRE/VERSION")") ;;
      KLEAN_IMAGES) A_ECRIRE+=("$cle" "$(nom_images)") ;;
    esac
  done <<< "$manquantes"
  if [ "${#A_ECRIRE[@]}" -gt 0 ]; then
    ecrire_env "${A_ECRIRE[@]}"
  fi
}

# Les variables d'env.modele (du dossier $1) absentes de .env, avec leur défaut. Jamais
# d'écrasement. Un échec est rendu, pour que l'appelant le dise : sous `||`, `set -e` ne
# l'arrêterait pas.
completer_env_version() {
  local cle valeur
  while IFS='=' read -r cle valeur; do
    case "$cle" in '' | \#*) continue ;; esac
    if [ "$valeur" = '@SECRET@' ]; then
      valeur=$(generer_secret 32)
    fi
    completer_env "$ENV" "$cle" "$valeur" || return 1
  done < "$1/env.modele"
}

verifier_dns() {
  local domaine="$1" resolues locales etrangeres
  locales=$(ip -o addr show scope global | awk '{ print $4 }' | cut -d/ -f1)
  resolues=$(getent ahosts "$domaine" | awk '{ print $1 }' | sort -u || true)
  if [ -z "$resolues" ]; then
    avertir "Le domaine $domaine ne pointe encore nulle part. Chez votre registraire, créez un enregistrement A vers ce serveur : $(tr '\n' ' ' <<< "$locales")"
  elif etrangeres=$(adresses_etrangeres "$resolues" "$locales"); then
    dire "Le domaine $domaine pointe bien sur ce serveur."
    DOMAINE_VERIFIE="$domaine"
    return
  else
    avertir "Le domaine $domaine pointe vers $(tr '\n' ' ' <<< "$etrangeres")— pas vers une adresse de ce serveur ($(tr '\n' ' ' <<< "$locales"))."
    avertir "C'est normal si votre hébergeur place ce serveur derrière une adresse publique à lui, que le serveur ne voit pas : dans ce cas, répondez oui."
    avertir "Sinon : un enregistrement IPv6 (AAAA) oublié suffit à faire échouer le certificat. Après un changement, la propagation peut prendre jusqu'à une heure."
  fi
  demander_oui_non "Continuer quand même ?" non ||
    echouer "Installation suspendue. Quand le domaine pointe sur ce serveur : sudo klean installer"
  DOMAINE_VERIFIE="$domaine"
}

# Interrogé en local, sous son vrai nom : le certificat est vérifié comme par un
# navigateur, sans dépendre du DNS vu d'ici — derrière l'adresse publique d'un
# hébergeur, un serveur ne se joint souvent pas lui-même.
#
# Jusqu'à huit minutes environ — vingt essais de dix secondes au plus, à quinze
# secondes d'intervalle : Caddy demande le certificat à son démarrage, et Let's Encrypt
# peut tarder. Interroger KLEAN ne redemande aucun certificat : attendre ne touche pas
# au plafond d'échecs de Let's Encrypt.
verifier_https() {
  local domaine essai code=000
  domaine=$(lire_env "$ENV" KLEAN_DOMAINE)
  dire "Attente de KLEAN en HTTPS, le temps d'obtenir le certificat (jusqu'à huit minutes)…"
  for essai in $(seq 1 20); do
    code=$(sonde_https)
    [ "$code" != 200 ] || return 0
    [ "$essai" -eq 20 ] || sleep 15
  done
  case "$code" in
    # Ni connexion ni poignée de main TLS : le certificat manque, presque toujours.
    000)
      avertir "https://$domaine ne répond pas : le certificat n'a pas pu être obtenu. Dernières lignes de Caddy :"
      compose logs --tail 30 caddy >&2 || true
      avertir "Vérifiez que le domaine pointe sur ce serveur, et que le pare-feu du panneau de votre hébergeur ouvre les ports 80 et 443."
      ;;
    502 | 503) avertir "Le certificat est en place, mais l'API ne démarre pas (code $code). Voir : sudo klean journaux" ;;
    *) avertir "KLEAN répond en HTTPS, mais pas comme prévu (code $code). Voir : sudo klean journaux" ;;
  esac
  return 1
}

# Un essai de verifier_https, sans attente : le code HTTP de la sonde, ou 000 sans
# réponse. `klean code` s'en sert seul.
sonde_https() {
  local domaine port code
  domaine=$(lire_env "$ENV" KLEAN_DOMAINE)
  port=$(lire_env "$ENV" KLEAN_PORT_HTTPS)
  port="${port:-443}"
  code=$(curl -sS --max-time 10 --resolve "$domaine:$port:127.0.0.1" -o /dev/null \
    -w '%{http_code}' "https://$domaine:$port/api/sante" 2> /dev/null) || true
  [[ $code =~ ^[0-9]{3}$ ]] || code=000
  printf '%s\n' "$code"
}

# Le mot de passe provisoire d'une installation 0.1.x inachevée, reprise par cette
# version : le lot A2 n'en écrit plus, et la fonction sort d'elle-même sans lui.
#
# L'amorçage ne lit ces variables que si la base n'a aucun compte : une fois le compte
# créé, le mot de passe n'a plus rien à faire dans .env (SPEC.md, étape 34).
#
# ⚠️ Montré, puis retiré, dans cet ordre : dans l'autre, une API qui ne redémarre pas
# ou une session ssh coupée pendant la recréation le perdaient sans qu'il ait été lu.
# Une interruption entre les deux le remontre à la relance, sans danger : c'est le même.
montrer_puis_retirer_mot_de_passe() {
  local mot_de_passe comptes
  mot_de_passe=$(lire_env "$ENV" KLEAN_ADMIN_MOT_DE_PASSE)
  [ -n "$mot_de_passe" ] || return 0
  # Une sortie vide n'est pas « des comptes existent » (cmd_code).
  comptes=$(nombre_de_comptes) || comptes=''
  [[ $comptes =~ ^[0-9]+$ ]] ||
    echouer "PostgreSQL ne répond pas : impossible de vérifier que le compte administrateur existe. Son mot de passe est gardé. Voir : sudo klean etat, puis relancez : sudo klean installer"
  [ "$comptes" -gt 0 ] || echouer "L'API tourne, mais aucun compte n'a été créé : voir sudo klean journaux."
  dire ''
  dire "Adresse de connexion : $(lire_env "$ENV" KLEAN_ADMIN_EMAIL)"
  dire "Mot de passe provisoire : $mot_de_passe"
  dire "Il ne sera plus affiché. La première connexion le fait remplacer, puis équiper la double authentification."
  while :; do
    demander "Notez-le maintenant, puis tapez NOTE"
    [ "$(rogner "${REPONSE^^}")" != NOTE ] || break
  done
  poser_env "$ENV" KLEAN_ADMIN_MOT_DE_PASSE '' ||
    echouer "Le mot de passe provisoire n'a pas pu être retiré de la configuration. Relancez : sudo klean installer"
  # Recréé sans : le conteneur en gardait le mot de passe dans son environnement.
  compose up -d api ||
    echouer "Le mot de passe provisoire est retiré de la configuration, mais l'API n'a pas redémarré. Voir : sudo klean journaux, puis relancez : sudo klean installer"
}

afficher_fin() {
  dire ''
  dire "KLEAN est installé : https://$(lire_env "$ENV" KLEAN_DOMAINE)"
  dire "Une sauvegarde se fait chaque nuit, dans $SAUVEGARDES et $TROUSSEAU."
  avertir "Elles restent sur ce serveur : copiez-les ailleurs, chacune de son côté (README, section Sauvegardes)."
  dire "État : sudo klean etat — Mise à jour : sudo klean mettre-a-jour"
}

# ---- Mettre à jour, revenir -----------------------------------------------------
#
# L'état d'une mise à jour tient dans quatre variables de .env :
#   KLEAN_VERSION_PRECEDENTE    la version d'avant, que `revenir` remet en place ;
#   KLEAN_SAUVEGARDE_AVANT_MAJ  la base d'avant, que `revenir` restaure ;
#   KLEAN_MAJ_EN_COURS          la version visée, de l'arrêt de l'API à son redémarrage.
#                               Posée, elle dit qu'une mise à jour n'a pas abouti : la
#                               relance la reprend, sans nouvelle sauvegarde — celle d'une
#                               base à moitié transformée prendrait la place de celle d'avant ;
#   KLEAN_RETOUR_EN_COURS       la version visée par un `revenir`, de l'arrêt de l'API à la
#                               fin de la restauration. Posée, la base est peut-être vide :
#                               seul `revenir` peut continuer, et une mise à jour, qui la
#                               sauvegarderait à la place de celle d'avant, est refusée.
#
# ⚠️ Ce que la version installée N exige de la version N+1. Une mise à jour est conduite
# par le `klean` de N, déjà sur chaque serveur : ce qui suit ne se change plus sans casser
# la mise à jour de tous ceux qui sont en N.
#   - Publication : https://github.com/<dépôt>/releases/latest redirige vers
#     …/releases/tag/v<v> ; …/releases/download/v<v>/klean-<v>.tar.gz, et à côté
#     klean-<v>.tar.gz.sha256, une ligne « <64 hexadécimaux en minuscules>  klean-<v>.tar.gz ».
#   - L'archive : des fichiers à plat, dont le manifeste FICHIERS (un simple nom par
#     ligne, VERSION en dernier), VERSION qui dit <v>, docker-compose.yml, env.modele, et
#     `klean`, exécutable, qui accepte `klean installer` (installation inachevée, ci-dessous).
#   - Le compose : un projet `klean`, des services postgres, api, caddy et migrer (profil
#     `outils`, le bundle de migration) ; les images désignées par KLEAN_IMAGES et
#     KLEAN_VERSION ; l'utilisateur et la base `klean` ; le trousseau dans
#     /home/app/.aspnet/DataProtection-Keys de l'image de l'API, qui porte `tar`.
#   - .env : aucune clé renommée ni retirée ; chaque variable obligatoire nouvelle a son
#     défaut dans env.modele, posé avant le téléchargement des images.
#   - Les quatre variables ci-dessus : après le remplacement des fichiers, c'est le
#     `klean` de N+1 qui reprend une mise à jour ratée et qui conduit `revenir`.
#   - La sonde : GET https://<KLEAN_DOMAINE>:<KLEAN_PORT_HTTPS>/api/sante répond 200 à
#     travers Caddy. N la lit après la bascule ; renommée, chaque mise à jour réussie
#     finirait par « ne répond pas… sudo klean revenir » — défaire une version saine.
#   - klean.cron dans l'archive et dans le manifeste : il est réinstallé à chaque version.
#   - env.modele : des lignes CLÉ=valeur, sans apostrophe ni guillemets, `#` pour un
#     commentaire, `@SECRET@` pour 32 octets hexadécimaux et rien d'autre ; une valeur que
#     poser_env refuse ferait échouer toute mise à jour, avant même l'arrêt.
#   - PostgreSQL reste en version majeure 16 : N ne sait pas faire de pg_upgrade, et un
#     postgres:17 face au volume existant ne démarrerait pas.
#   - Le compose reste lisible par le plugin docker compose de l'installation : rien ne
#     le met à jour de lui-même.
#   - Le code d'installation (lot A2) : le compose le lit sous le nom
#     KLEAN_CODE_INSTALLATION, et le passe à l'API en Installation__Code. Le compose lit
#     toujours KLEAN_ADMIN_EMAIL, KLEAN_ADMIN_MOT_DE_PASSE, KLEAN_RAISON_SOCIALE et
#     KLEAN_SIRET, la voie manuelle de DEPLOIEMENT.md : N les écrivait encore en 0.1.x.
#   - N conduit la mise à jour avec ses propres fonctions : ce que N+1 fait de neuf après
#     la bascule — retirer le code, par exemple — n'a lieu qu'à la commande suivante.

# Les fichiers d'un dossier de version sans manifeste FICHIERS, dans l'ordre de leur mise
# en place : fonctions.sh avant klean, qui le lit ; VERSION en dernier, comme dans
# installer.sh. Un dossier qui a son manifeste le suit : la liste de ce code-ci, figée
# dans le processus qui tourne, ne connaît pas les fichiers d'une version future.
FICHIERS_VERSION='docker-compose.yml fonctions.sh klean klean.cron env.modele VERSION'

# Les fichiers de la version du dossier $1, un par ligne. Échoue sur un manifeste invalide.
fichiers_de() {
  if [ -f "$1/FICHIERS" ]; then
    manifeste_valide "$(cat "$1/FICHIERS")"
  else
    # shellcheck disable=SC2086  # liste de noms simples, découpée exprès
    printf '%s\n' $FICHIERS_VERSION
  fi
}

# Jamais de HTTP, même au bout d'une redirection : GitHub renvoie les téléchargements
# vers un autre domaine, et curl suivrait par défaut une redirection en clair.
telecharger() {
  curl -fsSL --proto '=https' --proto-redir '=https' "$@"
}

derniere_version() {
  local url
  url=$(telecharger -I -o /dev/null -w '%{url_effective}' "$(url_derniere_version)") ||
    echouer "Impossible de joindre GitHub pour connaître la dernière version de KLEAN : le serveur est-il relié à Internet ? Rien n'a changé."
  version_depuis_url "$url" ||
    echouer "Aucune version publiée de KLEAN n'a été trouvée ($url). Rien n'a changé."
}

# Réussit si le dossier $1 porte tous les fichiers de la version $2, et bien les siens.
version_complete() {
  local liste fichier
  liste=$(fichiers_de "$1") || return 1
  while IFS= read -r fichier; do
    [ -f "$1/$fichier" ] || return 1
  done <<< "$liste"
  [ "$(cat "$1/VERSION" 2> /dev/null)" = "$2" ]
}

# Télécharge, vérifie et ouvre l'archive de la version $1 dans versions/$1, pendant que
# la version installée tourne : un refus ici n'a rien arrêté. Les versions déjà
# installées y restent — c'est ce que `revenir` remet en place.
#
# L'empreinte attendue est celle du klean-<v>.tar.gz.sha256 publié avec la version,
# relue comme une donnée (empreinte_publiee) puis comparée à celle du fichier reçu.
#   Ce qu'elle garantit : une archive entière — un téléchargement tronqué, abîmé, ou une
#   page d'erreur à la place est refusé avant tout arrêt —, et celle de cette version :
#   le .sha256 doit nommer klean-<v>.tar.gz, et VERSION, une fois l'archive ouverte,
#   doit dire <v>. Le transport : HTTPS jusqu'à GitHub, certificat vérifié par curl,
#   redirections comprises.
#   Ce qu'elle ne garantit pas : qui peut publier sur le dépôt change l'archive et son
#   empreinte ensemble. L'empreinte gravée dans l'installer.sh de la même version n'en
#   dirait pas plus — elle vient du même endroit, par le même chemin — et il faudrait
#   lire un script pour l'en extraire. Seule une signature dont la clé ne serait pas sur
#   GitHub fermerait ce cas : hors du lot A1.
telecharger_version() {
  local version="$1" dossier="$REPERTOIRE/versions/$1" nom="klean-$1.tar.gz" url publiee attendue obtenue
  url=$(url_archive "$version")
  install -d -m 700 "$REPERTOIRE/versions" "$dossier" ||
    echouer "Le dossier $dossier n'a pas pu être créé (disque plein ?). Rien n'a changé."
  dire "Téléchargement de KLEAN $version…"
  telecharger -o "$dossier/$nom" "$url" ||
    echouer "Téléchargement impossible : $url. Rien n'a changé ; réessayez dans quelques minutes."
  publiee=$(telecharger "$url.sha256") ||
    echouer "L'empreinte de la version $version est introuvable ($url.sha256). Rien n'a changé ; réessayez dans quelques minutes."
  attendue=$(empreinte_publiee "$publiee" "$nom") ||
    echouer "L'empreinte publiée pour la version $version est illisible. Rien n'a changé ; si cela se répète, signalez-le."
  obtenue=$(sha256sum "$dossier/$nom") ||
    echouer "L'archive téléchargée n'a pas pu être relue (disque plein ?). Rien n'a changé."
  if [ "${obtenue%% *}" != "$attendue" ]; then
    rm -f "$dossier/$nom"
    echouer "L'archive téléchargée n'est pas celle de KLEAN $version : rien n'a été installé, et la version actuelle tourne toujours. Réessayez plus tard ; si cela se répète, signalez-le."
  fi
  # --no-same-owner : extraite par root, l'archive ne doit pas poser un uid étranger.
  if ! tar xzf "$dossier/$nom" -C "$dossier" --no-same-owner || ! version_complete "$dossier" "$version"; then
    echouer "L'archive de la version $version ne contient pas ce qu'elle devrait. Rien n'a changé ; si cela se répète, signalez-le."
  fi
}

# `revenir` remet les fichiers de versions/<précédente> : ceux de la version installée
# doivent y être avant qu'elle soit remplacée. installer.sh les y laisse ; s'ils
# manquent, ce sont ceux de /opt/klean, s'ils sont bien de cette version.
conserver_version_actuelle() {
  local version="$1" dossier="$REPERTOIRE/versions/$1" liste fichier
  ! version_complete "$dossier" "$version" || return 0
  version_complete "$REPERTOIRE" "$version" ||
    echouer "Les fichiers de la version installée ($version) manquent, dans $dossier comme dans $REPERTOIRE : un retour arrière serait impossible, donc la mise à jour ne commence pas. Rien n'a changé. Relancez la commande d'installation de la version $version (page des versions de KLEAN), qui les remet en place, puis : sudo klean mettre-a-jour"
  liste=$(fichiers_de "$REPERTOIRE")
  install -d -m 700 "$REPERTOIRE/versions" "$dossier" ||
    echouer "Le dossier $dossier n'a pas pu être créé (disque plein ?). Rien n'a changé."
  while IFS= read -r fichier; do
    cp -p "$REPERTOIRE/$fichier" "$dossier/$fichier" ||
      echouer "Les fichiers de la version $version n'ont pas pu être mis de côté dans $dossier (disque plein ?). Rien n'a changé."
  done <<< "$liste"
}

# Remplace les fichiers de /opt/klean par ceux du dossier $1, chacun copié à côté puis
# renommé : ce script se remplace lui-même pendant qu'il tourne (voir l'en-tête). Un
# fichier exécutable dans la version le reste, `klean` toujours.
# Chaque échec est rendu, et non laissé à `set -e` : appelée derrière un `||`, la
# fonction ne s'arrêterait sinon sur aucun.
installer_fichiers() {
  local source="$1" liste fichier mode
  liste=$(fichiers_de "$source") || return 1
  while IFS= read -r fichier; do
    mode=600
    if [ "$fichier" = klean ] || [ -x "$source/$fichier" ]; then
      mode=700
    fi
    { install -m "$mode" "$source/$fichier" "$REPERTOIRE/.$fichier.nouveau" &&
      mv -f "$REPERTOIRE/.$fichier.nouveau" "$REPERTOIRE/$fichier"; } || return 1
  done <<< "$liste"
  # Mode et propriétaire explicites, comme à l'installation : cron refuse un fichier en 600.
  install -m 644 -o root -g root "$REPERTOIRE/klean.cron" /etc/cron.d/klean
}

# Les images de tout le projet de la version $1 — postgres et le bundle de migration
# compris —, que décrit le compose du dossier $2 : gardées si elles sont toutes là,
# téléchargées sinon. Toujours avant le premier arrêt : un réseau coupé ne doit rien
# laisser à moitié fait. La version visée passe par l'environnement : pour docker
# compose, il l'emporte sur .env (principal en a retiré tout le reste).
obtenir_images() {
  local version="$1" dossier="$2" images
  local -a projet=(docker compose --project-directory "$REPERTOIRE" --env-file "$ENV"
    -f "$dossier/docker-compose.yml" --profile outils)
  if images=$(KLEAN_VERSION="$version" "${projet[@]}" config --images 2> /dev/null) && [ -n "$images" ]; then
    local -a liste
    mapfile -t liste <<< "$images"
    ! docker image inspect "${liste[@]}" > /dev/null 2>&1 || return 0
  fi
  KLEAN_VERSION="$version" "${projet[@]}" pull
}

# Le nombre de comptes dont le mot de passe n'est plus le provisoire : ceux de quelqu'un
# qui s'est connecté. Sans base, ou sans table des comptes, zéro. Une réponse illisible
# est un échec, jamais un zéro. Gardée pour une installation 0.1.x inachevée
# (cmd_mettre_a_jour), seule à porter encore un mot de passe provisoire dans .env ; la
# colonne MotDePasseProvisoire reste celle de tout compte créé (CLAUDE.md §6).
comptes_utilises() {
  local table nombre
  if ! volume_postgres_existe; then
    printf '0\n'
    return 0
  fi
  compose up -d postgres > /dev/null || return 1
  attendre_postgres
  table=$(compose exec -T postgres psql -U klean -d klean -tAc \
    "SELECT to_regclass('public.\"AspNetUsers\"') IS NOT NULL") || return 1
  case "$table" in
    f) printf '0\n'; return 0 ;;
    t) ;;
    *) return 1 ;;
  esac
  nombre=$(compose exec -T postgres psql -U klean -d klean -tAc \
    'SELECT count(*) FROM "AspNetUsers" WHERE NOT "MotDePasseProvisoire"') || return 1
  [[ $nombre =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$nombre"
}

cmd_mettre_a_jour() {
  exiger_root
  # Sans attente, comme `restaurer` : pendant la sauvegarde de la nuit, elle échoue tout
  # de suite et dit pourquoi.
  verrouiller
  [ -f "$ENV" ] ||
    echouer "KLEAN n'est pas installé sur ce serveur ($ENV manque) : rien à mettre à jour. Pour l'installer, prenez la commande de la page des versions de KLEAN."
  local actuelle cible en_cours retour enmarche utilises
  actuelle=$(lire_env "$ENV" KLEAN_VERSION)
  en_cours=$(lire_env "$ENV" KLEAN_MAJ_EN_COURS)
  retour=$(lire_env "$ENV" KLEAN_RETOUR_EN_COURS)

  # Avant tout : la base est peut-être vide, et la voie normale la sauvegarderait, puis
  # noterait cette sauvegarde vide comme celle d'avant la mise à jour.
  [ -z "$retour" ] ||
    echouer "Un retour à la version $retour n'a pas abouti : la base est peut-être vide, et l'API arrêtée. Rien n'a changé. Terminez-le d'abord : sudo klean revenir"

  if [ -n "$en_cours" ]; then
    [ -z "${1:-}" ] || [ "$1" = "$en_cours" ] ||
      echouer "La mise à jour vers $en_cours n'a pas abouti. Terminez-la d'abord (sudo klean mettre-a-jour), ou annulez-la (sudo klean revenir). Rien n'a changé."
    dire "La mise à jour vers $en_cours n'avait pas abouti : elle reprend là où elle s'était arrêtée."
    dire "Aucune nouvelle sauvegarde n'est prise — elle serait celle d'une base à moitié transformée. Celle d'avant la mise à jour reste : $(lire_env "$ENV" KLEAN_SAUVEGARDE_AVANT_MAJ)"
    basculer_vers "$en_cours" "$(lire_env "$ENV" KLEAN_VERSION_PRECEDENTE)" \
      "$(lire_env "$ENV" KLEAN_SAUVEGARDE_AVANT_MAJ)" reprise
    retirer_code_si_installe
    return
  fi

  version_valide "$actuelle" ||
    echouer "La version installée est inconnue (KLEAN_VERSION vaut « $actuelle » dans $ENV). Rien n'a changé. Reprenez l'installation : sudo klean installer"
  cible="${1:-}"
  if [ -z "$cible" ]; then
    dire "Recherche de la dernière version publiée…"
    cible=$(derniere_version)
  fi
  version_valide "$cible" ||
    echouer "Version invalide : « $cible » (attendu : trois nombres, par exemple 1.2.3). Rien n'a changé."
  if [ "$cible" = "$actuelle" ]; then
    dire "KLEAN est déjà en version $actuelle : rien à faire."
    return
  fi
  # Une version plus ancienne ne s'installe pas par-dessus : ses images ne connaissent pas
  # le schéma de la base, et ses migrations ne le défont pas — le code qui le défait n'est
  # que dans la version qui l'a fait (CLAUDE.md §10). Le seul retour est `revenir`, qui
  # restaure la base d'avant la mise à jour.
  if version_anterieure "$cible" "$actuelle"; then
    echouer "La version $cible est plus ancienne que celle installée ($actuelle) : KLEAN ne se rétrograde pas ainsi. Rien n'a changé. Pour défaire la dernière mise à jour, dans les quatorze jours : sudo klean revenir"
  fi

  # Le mot de passe provisoire n'est retiré de .env qu'une fois montré, à la toute fin
  # de l'installation : encore là, l'installation n'a pas fini. Mais un Ctrl-C à la
  # dernière question laisse une instance qui sert peut-être depuis des semaines : seuls
  # les comptes disent si quelqu'un s'est connecté, c'est-à-dire a remplacé un mot de
  # passe provisoire. Personne : rien à sauvegarder, la nouvelle version prend la place
  # et c'est son installation qui reprend — avec ses corrections, si l'ancienne échouait.
  #
  # Depuis le lot A2, aucune installation n'écrit plus de mot de passe provisoire : ce
  # chemin ne sert qu'une installation 0.1.x inachevée, mise à jour par cette version.
  if [ -n "$(lire_env "$ENV" KLEAN_ADMIN_MOT_DE_PASSE)" ]; then
    utilises=$(comptes_utilises) ||
      echouer "PostgreSQL ne répond pas : impossible de savoir si KLEAN est déjà utilisé. Rien n'a changé. Voir : sudo klean etat"
    if [ "$utilises" -eq 0 ]; then
      dire "L'installation de KLEAN $actuelle n'était pas terminée, et personne ne s'y est encore connecté : la version $cible prend sa place, puis l'installation reprend."
      telecharger_version "$cible"
      installer_fichiers "$REPERTOIRE/versions/$cible" ||
        echouer "Les fichiers de la version $cible n'ont pas pu être mis en place. Relancez : sudo klean mettre-a-jour"
      poser_env "$ENV" KLEAN_VERSION "$cible" ||
        echouer "La configuration n'a pas pu être mise à jour. Relancez : sudo klean mettre-a-jour"
      # Le verrou passe au nouveau processus par son descripteur, qui le reprend aussitôt.
      exec "$REPERTOIRE/klean" installer
    fi
    # Quelqu'un a remplacé son mot de passe : le provisoire ne sert plus à rien.
    poser_env "$ENV" KLEAN_ADMIN_MOT_DE_PASSE '' ||
      echouer "Le mot de passe provisoire n'a pas pu être retiré de la configuration. Rien n'a changé. Relancez : sudo klean mettre-a-jour"
    avertir "L'installation ne s'était pas terminée, mais KLEAN est déjà utilisé : le mot de passe provisoire, qui ne sert plus, est retiré de la configuration, et la mise à jour suit son cours, sauvegarde comprise."
  fi

  conserver_version_actuelle "$actuelle"
  telecharger_version "$cible"
  # Avant les images : une variable obligatoire nouvelle de $cible ferait échouer docker
  # compose sur son compose, à chaque essai. Des ajouts seulement, que $actuelle ignore.
  completer_env_version "$REPERTOIRE/versions/$cible" ||
    echouer "La configuration n'a pas pu recevoir les réglages de la version $cible : rien d'autre n'a changé, KLEAN $actuelle tourne toujours. Relancez : sudo klean mettre-a-jour"
  dire "Téléchargement des images de la version $cible, pendant que $actuelle tourne…"
  obtenir_images "$cible" "$REPERTOIRE/versions/$cible" ||
    echouer "Le téléchargement des images de la version $cible a échoué : rien n'a changé, KLEAN $actuelle tourne toujours. Réessayez dans quelques minutes : sudo klean mettre-a-jour"

  # L'API doit tourner : le trousseau se sauvegarde depuis son conteneur.
  compose up -d ||
    echouer "KLEAN $actuelle ne démarre pas, et la sauvegarde d'avant la mise à jour en a besoin. Rien n'a changé. Voir : sudo klean etat, puis sudo klean journaux."
  attendre_postgres
  enmarche=$(compose ps --status running --services 2> /dev/null) || enmarche=''
  grep -qx api <<< "$enmarche" ||
    echouer "L'API de KLEAN $actuelle ne démarre pas, et la sauvegarde d'avant la mise à jour a besoin d'elle. Rien n'a changé. Voir : sudo klean etat, puis sudo klean journaux."
  dire "Sauvegarde d'avant la mise à jour. Si elle échoue, tout s'arrête là, sans rien changer."
  cmd_sauvegarder "avant-$cible"
  basculer_vers "$cible" "$actuelle" "$DERNIERE_SAUVEGARDE"
  # Après la bascule réussie — basculer_vers s'arrête sur tout échec. ⚠️ Ce geste est celui
  # du `klean` qui conduit la mise à jour, donc de la version d'avant : une 0.1.x ne le
  # connaît pas, et le code reste dans .env jusqu'au prochain `klean etat`, ou jusqu'à la
  # sauvegarde de la nuit.
  retirer_code_si_installe
}

# De l'arrêt de l'API à son redémarrage sous la version $1 ; $2 la version d'avant, $3 sa
# sauvegarde ; $4 = reprise quand une mise à jour ratée reprend. Chaque geste se rejoue.
basculer_vers() {
  local cible="$1" precedente="$2" sauvegarde="$3" base="la base n'a pas changé" retour
  [ -z "${4:-}" ] || base="la base a peut-être reçu une partie des changements de $cible"
  retour="Pour revenir à $precedente et à la base d'avant la mise à jour : sudo klean revenir"
  # Les saisies faites après la sauvegarde, jusqu'ici, seraient perdues par un `revenir`
  # (plan de l'étape 34, décision 4) : quelques secondes, et `revenir` le dit.
  compose stop api ||
    echouer "L'API n'a pas pu être arrêtée. Voir : sudo klean etat, puis relancez : sudo klean mettre-a-jour"
  # Noté une fois l'API arrêtée, d'un seul geste : avant, rien n'a changé, et une relance
  # repart du début.
  ecrire_env KLEAN_VERSION_PRECEDENTE "$precedente" KLEAN_SAUVEGARDE_AVANT_MAJ "$sauvegarde" \
    KLEAN_MAJ_EN_COURS "$cible"
  installer_fichiers "$REPERTOIRE/versions/$cible" ||
    echouer "Les fichiers de la version $cible n'ont pas pu être mis en place ; l'API est arrêtée, $base. Reprenez : sudo klean mettre-a-jour. $retour"
  completer_env_version "$REPERTOIRE" ||
    echouer "La configuration n'a pas pu recevoir les réglages de la version $cible ; l'API est arrêtée, $base. Reprenez : sudo klean mettre-a-jour. $retour"
  poser_env "$ENV" KLEAN_VERSION "$cible" ||
    echouer "La configuration n'a pas pu être mise à jour ; l'API est arrêtée, $base. Reprenez : sudo klean mettre-a-jour. $retour"
  dire "Mise à niveau de la base pour la version $cible…"
  if ! compose run --rm -T migrer; then
    avertir "La mise à niveau de la base pour la version $cible a échoué (voir les lignes ci-dessus). L'API est arrêtée : KLEAN est inaccessible."
    avertir "La base a peut-être reçu une partie des changements de $cible. Celle d'avant la mise à jour est gardée : $sauvegarde"
    echouer "Si la cause est corrigée (un disque plein, par exemple), reprenez : sudo klean mettre-a-jour. $retour"
  fi
  compose up -d ||
    echouer "La version $cible est en place, mais KLEAN n'a pas démarré. Voir : sudo klean journaux, puis reprenez : sudo klean mettre-a-jour. $retour"
  # La mise à jour est faite : un défaut d'HTTPS ne doit pas bloquer la suivante.
  poser_env "$ENV" KLEAN_MAJ_EN_COURS '' ||
    avertir "KLEAN tourne en version $cible, mais la configuration n'a pas pu le noter : la prochaine commande reprendra une mise à jour déjà faite, sans dommage."
  verifier_https ||
    echouer "KLEAN est passé en version $cible, mais ne répond pas en HTTPS (voir ci-dessus). Si cela vient de la nouvelle version : sudo klean revenir"
  dire "KLEAN est passé de la version $precedente à la version $cible."
  dire "En cas de problème, dans les quatorze jours : sudo klean revenir — ce qui aura été saisi depuis serait perdu."
}

cmd_revenir() {
  exiger_root
  verrouiller
  [ -f "$ENV" ] || echouer "KLEAN n'est pas installé sur ce serveur ($ENV manque) : rien à défaire."
  local actuelle precedente sauvegarde dossier en_cours retour
  actuelle=$(lire_env "$ENV" KLEAN_VERSION)
  precedente=$(lire_env "$ENV" KLEAN_VERSION_PRECEDENTE)
  sauvegarde=$(lire_env "$ENV" KLEAN_SAUVEGARDE_AVANT_MAJ)
  en_cours=$(lire_env "$ENV" KLEAN_MAJ_EN_COURS)
  retour=$(lire_env "$ENV" KLEAN_RETOUR_EN_COURS)
  version_valide "$precedente" ||
    echouer "Aucune mise à jour à défaire : KLEAN $actuelle n'a pas été mis à jour depuis son installation, ou le retour a déjà été fait. Rien n'a changé."

  # Tout se vérifie avant le premier arrêt.
  dossier="$REPERTOIRE/versions/$precedente"
  version_complete "$dossier" "$precedente" ||
    echouer "Les fichiers de la version $precedente manquent dans $dossier : le retour est impossible. Rien n'a changé ; KLEAN reste en version $actuelle."
  # La sauvegarde d'avant la mise à jour suit la rotation : quatorze jours, pas plus.
  if [ -z "$sauvegarde" ] || [ ! -f "$sauvegarde" ]; then
    lister_sauvegardes >&2
    [ -n "$sauvegarde" ] || sauvegarde='aucune notée'
    echouer "La sauvegarde prise avant la mise à jour n'existe plus ($sauvegarde) : les sauvegardes sont gardées quatorze jours. Le retour à $precedente n'est plus possible, et rien n'a changé : KLEAN reste en version $actuelle. Pour remettre la base à l'une des sauvegardes ci-dessus, dans cette version : sudo klean restaurer <fichier>"
  fi
  compose up -d postgres ||
    echouer "PostgreSQL n'a pas démarré : rien n'a changé. Voir : sudo klean journaux"
  attendre_postgres
  # Relue en entier, comme par `restaurer` : avant de détruire, savoir qu'elle se lit.
  compose exec -T postgres pg_restore -f /dev/null < "$sauvegarde" ||
    echouer "La sauvegarde d'avant la mise à jour ($sauvegarde) est illisible : le retour est impossible. Rien n'a changé ; KLEAN reste en version $actuelle."
  obtenir_images "$precedente" "$dossier" ||
    echouer "Les images de la version $precedente n'ont pas pu être téléchargées : rien n'a changé. Réessayez dans quelques minutes : sudo klean revenir"

  if [ -n "$retour" ]; then
    avertir "Un retour à la version $precedente a été interrompu : il reprend, et la base est de nouveau remise telle qu'elle était avant la mise à jour."
  else
    avertir "Retour de la version $actuelle à la version $precedente, et de la base à son état d'avant la mise à jour (${sauvegarde##*/})."
  fi
  [ -z "$en_cours" ] || avertir "La mise à jour vers $en_cours, qui n'avait pas abouti, est abandonnée."
  avertir "Tout ce qui a été saisi depuis la mise à jour sera perdu — y compris les quelques secondes entre sa sauvegarde et l'arrêt de l'API."
  avertir "Toutes les sessions sont fermées : chacun devra se reconnecter."
  avertir "L'état actuel sera d'abord copié dans $SAUVEGARDES (…-avant-restauration.dump, gardé 14 jours)."
  confirmer "Revenir à la version $precedente ?" REVENIR || echouer "Retour abandonné. Rien n'a changé."

  compose stop api ||
    echouer "L'API n'a pas pu être arrêtée : rien n'a changé. Voir : sudo klean etat"
  # D'un seul geste, avant de toucher aux fichiers : dès maintenant, seul `revenir` peut
  # continuer (voir KLEAN_RETOUR_EN_COURS en tête de section).
  ecrire_env KLEAN_RETOUR_EN_COURS "$precedente" KLEAN_VERSION "$precedente" KLEAN_MAJ_EN_COURS ''
  installer_fichiers "$dossier" ||
    echouer "Les fichiers de la version $precedente n'ont pas pu être remis en place ; l'API est arrêtée, la base n'a pas encore été touchée. Relancez : sudo klean revenir"
  # Aucune migration descendante : la base entière est remplacée par celle d'avant la
  # mise à jour, et l'image de $precedente ne connaîtrait de toute façon pas le code qui
  # défait les migrations suivantes (CLAUDE.md §10 ; plan de l'étape 34, décision 3).
  restaurer_base "$sauvegarde" '' 'sudo klean revenir'
  # D'un seul geste : tant qu'elles restent, `revenir` remettrait la base d'avant la mise
  # à jour par-dessus ce qui sera saisi demain.
  ecrire_env KLEAN_RETOUR_EN_COURS '' KLEAN_VERSION_PRECEDENTE '' KLEAN_SAUVEGARDE_AVANT_MAJ ''
  verifier_https ||
    echouer "KLEAN est revenu en version $precedente, mais ne répond pas en HTTPS (voir ci-dessus) : sudo klean etat, puis sudo klean journaux."
  dire "KLEAN est revenu en version $precedente, avec la base d'avant la mise à jour. Chacun doit se reconnecter."
  dire "Pour retenter la mise à jour plus tard : sudo klean mettre-a-jour"
}

# ---- Aiguillage ------------------------------------------------------------------

aide() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

principal() {
  # Lancé par `curl … | sudo bash`, l'entrée standard est le tube du téléchargement :
  # coupée, pour qu'aucun `docker compose` ne la lise. Les questions passent par
  # /dev/tty, et chaque restauration redirige la sienne explicitement.
  exec < /dev/null
  # Ce qui pilote docker compose vient de .env, et de rien d'autre : une variable
  # exportée — `sudo -E`, un profil — l'emporterait sinon sur .env, et une mise à jour
  # tirerait d'autres images que celles notées. Seuls les réglages de ce script restent,
  # déjà lus. obtenir_images passe la version visée par l'environnement de son seul appel.
  local nom
  for nom in $(compgen -e); do
    case "$nom" in
      KLEAN_REPERTOIRE | KLEAN_SAUVEGARDES | KLEAN_VERROU | KLEAN_TROUSSEAU | KLEAN_DEPOT_GITHUB) ;;
      KLEAN_* | POSTGRES_*) unset "$nom" ;;
    esac
  done
  COMMANDE="${1:-aide}"
  shift || true
  case "$COMMANDE" in
    installer) cmd_installer ;;
    sauvegarder)
      if [ "${1:-}" = --nuit ]; then cmd_sauvegarde_de_nuit; else cmd_sauvegarder "$@"; fi
      ;;
    etat) cmd_etat ;;
    journaux) cmd_journaux "$@" ;;
    code) cmd_code ;;
    restaurer) cmd_restaurer "$@" ;;
    mettre-a-jour) cmd_mettre_a_jour "$@" ;;
    revenir) cmd_revenir ;;
    aide | -h | --help) aide ;;
    *)
      printf 'Commande inconnue : %s\n\n' "$COMMANDE" >&2
      aide >&2
      exit 2
      ;;
  esac
}

principal "$@"
