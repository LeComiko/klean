{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    /* DOM et node ensemble : les séries tournent sous Node, mais elles importent
       du code navigateur — client.ts touche document.cookie et fetch. */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* Node exige l'extension .ts dans le spécificateur d'import, contrairement à
       Vite qui la résout. Les fichiers de série écrivent donc './dates.ts'. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts"]
}
