# Configuration d'une instance KLEAN sous docker compose.
#
#     cp .env.example .env && chmod 600 .env
#
# ⚠️ .env contient des secrets. Il est ignoré par git ; ne jamais le committer,
# ne jamais le copier dans une image. Voir DEPLOIEMENT.md, section Secrets, pour
# ce qui se tourne, quand et comment.

# ---------------------------------------------------------------------------
# Obligatoire
# ---------------------------------------------------------------------------

# Nom de domaine de l'instance, sans https://. Doit pointer sur cette machine.
KLEAN_DOMAINE=klean.votre-domaine.fr

# Mot de passe de PostgreSQL. En hexadécimal : un « ; » ou un « = » couperait la
# chaîne de connexion.
#     openssl rand -hex 32
POSTGRES_PASSWORD=

# Clé de signature des jetons de session, 32 octets au moins.
#     openssl rand -base64 64 | tr -d '\n'
KLEAN_JWT_CLE=

# ---------------------------------------------------------------------------
# Premier démarrage seulement
# ---------------------------------------------------------------------------
# Lues uniquement si la base n'a encore aucun compte : l'API crée alors
# l'entreprise et son administrateur. Après la première connexion et le
# changement de mot de passe depuis l'écran Compte, VIDER ces lignes.
KLEAN_ADMIN_EMAIL=
KLEAN_ADMIN_MOT_DE_PASSE=
KLEAN_RAISON_SOCIALE=
KLEAN_SIRET=

# ---------------------------------------------------------------------------
# Optionnel
# ---------------------------------------------------------------------------

# SMTP, pour la réinitialisation de mot de passe. Hôte vide : désactivée, elle
# répond 503. Hôte renseigné sans expéditeur : l'API refuse de démarrer.
KLEAN_SMTP_HOTE=
KLEAN_SMTP_PORT=587
KLEAN_SMTP_EXPEDITEUR=
KLEAN_SMTP_UTILISATEUR=
KLEAN_SMTP_MOT_DE_PASSE=

# Ports publiés par Caddy. 80 et 443 en production : Let's Encrypt les exige.
# KLEAN_PORT_HTTP=80
# KLEAN_PORT_HTTPS=443
